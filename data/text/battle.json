{
	"note": "The fight's log lines. {name} placeholders are filled by GameMessages.line(key, vars); a key must exist here and every placeholder must be given. Words that vary (a status's own lines, a toxin's, an ability's text) live with their own data.",
	"lines": {
		"hit": "{who} hits {whom} for {n}{tail}.",
		"hit_ward": "{who} hits {whom} for {n} ({absorbed} absorbed){tail}.",
		"hit_ward_all": "{who} hits {whom}, and the ward absorbs all {absorbed}.",
		"foe_defeated": "{name} is defeated.",
		"foe_steps_up": "{name} steps up to the front.",
		"back_rank_steps_up": "The back rank steps up to the front.",
		"ally_knocked_out": "{name} is knocked senseless and out of the fight.",
		"dragons_breath": "{name} breathes fire over the foes.",
		"foe_dodged": "{foe} dodges {name}'s attack.",
		"blood_magic_cost": "Blood Magic costs {name} {n} HP.",
		"feat_hp_cost": "{feat} costs {name} {n} HP.",
		"casts": "{name} casts {ability}.",
		"uses": "{name} uses {ability}.",
		"foe_resists": "{name} resists {what}.",
		"foes_resist": "{n} foes resist {what}.",
		"mana_drawn": "{name} draws in {n} MP.",
		"brace": "{name} braces for impact.",
		"hold_back": "{name} holds back.",
		"escape_alone": "{name} escapes!",
		"escape_party": "{name} and the party escape!",
		"escape_failed": "{name} fails to escape!",
		"restores": "{name} restores {n} HP ({source}).",
		"tends": "{healer} tends {name}: +{n} HP ({source}).",
		"steps_in_front": "{by} steps in front of {who}.",
		"victory": "Victory!",
		"fallen": "{name} has fallen...",
		"improvises": "{name} improvises.",
		"foe_missed": "{foe} attacks, but {name} dodges.",
		"mana_blow": "{name}'s mana takes {n} of the blow."
	}
}
