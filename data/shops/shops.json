  "bought_wear": "{name} buys {item} for {price} gold and puts it on.",
  "sold": "{name} sells {item} to {shop} for {price} gold.",
  "bought_material": "{name} buys {n} {material} for {price} gold.",
  "sold_material": "{name} sells {n} {material} for {price} gold.",
  "not_open": "{shop} is shut. It opens at {opens} and closes at {closes}.",
    "closing_soon": "{shop} closes at {closes}.",
    "all_shut": "Every shop here is shut for now.",
    "shut_tab": "Shut until {opens} (open {opens} to {closes}).",
  "not_here": "There is no {shop} here.",
  "not_on_shelf": "{shop} does not have that.",
  "no_gold": "{name} cannot afford {item}: it costs {price} gold.",
  "no_trade": "{shop} does not buy {item}.",
  "not_in_pack": "{name} has no {item}.",
  "no_stock": "{shop} has nothing on the shelves today.",
  "used": "{name} uses {item}.",
  "no_use": "{item} cannot be used.",
  "no_need": "{name} needs nothing from {item}.",
  "service_done": "{name} pays {price} gold at {shop}: {what}.",
