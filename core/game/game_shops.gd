## The shops of the towns beyond the six old services (data/shops/shops.json): a bakery, an armourer, a jeweller and so on. Each is a
## service a town lists in world.json, with its shelves generated by GameShopStock, goods it buys back, an opening time, and
## sometimes a service (a bath). None of them is known to the autopilot: GameItems.SHOPS is still the six old services, so nothing
## here moves a seeded life. Buying and selling draw no dice and take no time. Pure functions of the dynasty and the data.
class_name GameShops
extends RefCounted

const PATH := "res://data/shops/shops.json"

static var _cache: Dictionary = {}
static var _by_id: Dictionary = {}


static func data() -> Dictionary:
	if _cache.is_empty():
		_cache = GameData.load_json(PATH)
		_by_id = {}
		for s in _cache["shops"]:
			_by_id[str(s["id"])] = s
	return _cache


static func setting(key: String) -> Variant:
	return data()["settings"][key]


static func text(key: String, vals: Dictionary = {}) -> String:
	return str(data()["text"][key]).format(vals)


static func ids() -> Array:
	data()
	return _by_id.keys()


static func is_shop(id: String) -> bool:
	data()
	return _by_id.has(id)


static func def(id: String) -> Dictionary:
	data()
	return _by_id.get(id, {})


static func name_of(id: String) -> String:
	return str(def(id).get("name", id))


static func tab_of(id: String) -> String:
	return str(def(id).get("tab", id))


## The shops in the dynasty's town, in the data's order.
static func here(d: GameDynasty) -> Array:
	var out: Array = []
	for id in ids():
		if d.world.has_service(str(id)):
			out.append(id)
	return out


## Whether a shop is open at an hour of the day (24-hour clock). A service that is not a shop is always open.
static func open_at(id: String, hour: float) -> bool:
	if not is_shop(id):
		return true
	var h: Array = def(id)["hours"]
	return hour >= float(h[0]) and hour < float(h[1])


static func is_open(d: GameDynasty, id: String) -> bool:
	return open_at(id, GameDay.hour(d))


static func opens_text(id: String) -> String:
	return "%02d:00" % int(def(id)["hours"][0])


# ---------------------------------------------------------------- the shelves

static func stock(d: GameDynasty, shop_id: String) -> Array:
	return GameShopStock.stock(d, shop_id)


static func entry(d: GameDynasty, shop_id: String, key: String) -> Dictionary:
	for e in stock(d, shop_id):
		if str(e["key"]) == key:
			return e
	return {}


## What an entry costs the heir here: an item at its price times the shop's markup, the town's prices and the heir's haggling;
## a bundle of material at the unit price of its kind; an animal at the farm market's price.
static func price(d: GameDynasty, shop_id: String, e: Dictionary) -> int:
	var markup := float(def(shop_id).get("markup", 1.0))
	match str(e["kind"]):
		"item":
			return maxi(1, int(round(float(GameItems.item_def(str(e["id"])).get("price", 0)) * markup * GameItems.price_mult(d))))
		"material":
			return maxi(1, int(round(unit_price(str(e["id"])) * int(e["n"]) * markup * float(setting("bundle_markup")) * GameItems.price_mult(d))))
		"animal":
			return GameFarm.price(str(e["id"]))
	return 0


static func unit_price(material: String) -> float:
	return float(setting("material_unit")) * float(GameMaterials.get_material(material).get("price_mult", 1.0))


static func entry_name(e: Dictionary) -> String:
	match str(e["kind"]):
		"item":
			return GameItems.item_name(str(e["id"]))
		"material":
			return "%d %s" % [int(e["n"]), GameMaterials.name_of(str(e["id"])).to_lower()]
		"animal":
			return "%s (%s)" % [str(GameCombat.creature_def(str(e["id"])).get("name", e["id"])), GameFarm.young_name(str(e["id"]))]
	return str(e["id"])


# ---------------------------------------------------------------- buying

## Buys an entry of the shelf by its key. Returns the line to tell (also written to the journal by the screen).
static func buy(d: GameDynasty, shop_id: String, key: String) -> String:
	var h := d.heir
	if not d.world.has_service(shop_id):
		return text("not_here", {"shop": name_of(shop_id)})
	var e := entry(d, shop_id, key)
	if e.is_empty():
		return text("not_on_shelf", {"shop": name_of(shop_id)})
	var cost := price(d, shop_id, e)
	var nm := entry_name(e)
	match str(e["kind"]):
		"animal":
			var why := GameFarm.why_not_buy(d, str(e["id"]))
			if why != "":
				return why
			return GameFarm.buy(d, str(e["id"]))
		"material":
			if h.gold < cost:
				return text("no_gold", {"name": h.name, "item": nm, "price": GameText.num(cost)})
			h.gold -= cost
			GameCraft.add_material(d, str(e["id"]), int(e["n"]))
			return text("bought_material", {"name": h.name, "n": int(e["n"]), "material": GameMaterials.name_of(str(e["id"])).to_lower(), "price": GameText.num(cost)})
	var id := str(e["id"])
	if GameItems.stack_max(id) > 0 and GameItems.count(h, id) >= GameItems.stack_max(id):
		return GameMessages.text("life", "cannot_carry_more", {"name": h.name, "max": int(GameItems.stack_max(id)), "item": nm})
	if GameItems.stack_max(id) <= 0 and GameItems.owns(h, id):
		return GameMessages.text("life", "already_has", {"name": h.name, "item": nm})
	if h.gold < cost:
		return text("no_gold", {"name": h.name, "item": nm, "price": GameText.num(cost)})
	if not GameCarry.can_carry(h, id):
		return GameCarry.why_not(h, id)
	h.gold -= cost
	h.inventory.append(id)
	if GameItems.slot_of(id) in GameItems.SLOTS and GameItems.equipped(h, GameItems.slot_of(id)) == "":
		GameItems._wear(h, id)
		return text("bought_wear", {"name": h.name, "item": nm, "price": GameText.num(cost)})
	return text("bought", {"name": h.name, "item": nm, "price": GameText.num(cost)})


# ---------------------------------------------------------------- selling

## Whether a shop buys an item (never a unique one or an unknown one).
static func buys(shop_id: String, id: String) -> bool:
	var it := GameItems.item_def(id)
	if it.is_empty() or it.get("unique", false):
		return false
	var b: Dictionary = def(shop_id).get("buys", {})
	if bool(b.get("all", false)):
		return true
	if id in b.get("ids", []):
		return true
	if GameItems.kind_of(id) in b.get("kinds", []):
		return true
	for t in b.get("tags", []):
		if str(t) in it.get("tags", []):
			return true
	return false


static func sell_price(d: GameDynasty, shop_id: String, id: String) -> int:
	var v := float(GameItems.item_def(id).get("price", 0)) * GameData.enemy_scale(d.gen) * float(def(shop_id)["buy"]) * GameSubclass.perk(d.heir, "sell_mult")
	return maxi(1, int(round(v / ((1.0 + d.echo_total("infamy")) * GameFactions.town_mult(d, "price")))))


## The pack items a shop would buy, each once.
static func sellable(d: GameDynasty, shop_id: String) -> Array:
	var out: Array = []
	for id in d.heir.inventory:
		if str(id) not in out and buys(shop_id, str(id)):
			out.append(str(id))
	return out


static func sell(d: GameDynasty, shop_id: String, id: String) -> String:
	var h := d.heir
	if not d.world.has_service(shop_id):
		return text("not_here", {"shop": name_of(shop_id)})
	if id not in h.inventory:
		return text("not_in_pack", {"name": h.name, "item": GameItems.item_name(id)})
	if not buys(shop_id, id):
		return text("no_trade", {"shop": name_of(shop_id), "item": GameItems.item_name(id)})
	var gold := sell_price(d, shop_id, id)
	h.inventory.erase(id)
	if not GameItems.owns(h, id):
		h.tainted_gear.erase(id)
	h.gold += gold
	return text("sold", {"name": h.name, "item": GameItems.item_name(id), "shop": name_of(shop_id), "price": GameText.num(gold)})


static func buys_material(shop_id: String, material: String) -> bool:
	var b: Dictionary = def(shop_id).get("buys", {})
	if bool(b.get("all", false)):
		return true
	if material in b.get("materials", []):
		return true
	for t in b.get("material_tags", []):
		if str(t) in GameMaterials.tags_of(material):
			return true
	return false


## The materials in the family's stores that a shop buys: [{id, have, price}] (price of one unit).
static func sellable_materials(d: GameDynasty, shop_id: String) -> Array:
	var out: Array = []
	var have := GameCraft.materials(d)
	var keys: Array = have.keys()
	keys.sort()
	for m in keys:
		if buys_material(shop_id, str(m)):
			out.append({"id": str(m), "have": int(have[m]), "price": material_sell_price(d, shop_id, str(m))})
	return out


static func material_sell_price(d: GameDynasty, shop_id: String, material: String) -> int:
	var v := unit_price(material) * GameData.enemy_scale(d.gen) * float(def(shop_id)["buy"])
	return maxi(1, int(round(v / ((1.0 + d.echo_total("infamy")) * GameFactions.town_mult(d, "price")))))


static func sell_material(d: GameDynasty, shop_id: String, material: String, n: int) -> String:
	var h := d.heir
	if not d.world.has_service(shop_id):
		return text("not_here", {"shop": name_of(shop_id)})
	var nm := GameMaterials.name_of(material).to_lower()
	if not buys_material(shop_id, material):
		return text("no_trade", {"shop": name_of(shop_id), "item": nm})
	n = mini(n, GameCraft.have(d, material))
	if n <= 0:
		return text("not_in_pack", {"name": h.name, "item": nm})
	var gold := material_sell_price(d, shop_id, material) * n
	GameCraft.add_material(d, material, -n)
	h.gold += gold
	return text("sold_material", {"name": h.name, "n": n, "material": nm, "price": GameText.num(gold)})


# ---------------------------------------------------------------- using

## Uses one of a pack item with a `use` (eat, drink, read): restores a share of the heir's health or magic. Takes no time and draws no
## dice; refused in a fight or when it would do nothing.
static func use(d: GameDynasty, id: String) -> String:
	var h := d.heir
	var it := GameItems.item_def(id)
	var u: Dictionary = it.get("use", {})
	var nm := GameItems.item_name(id)
	if u.is_empty():
		return text("no_use", {"item": nm})
	if id not in h.inventory:
		return text("not_in_pack", {"name": h.name, "item": nm})
	if d.battle != null:
		return text("no_use", {"item": nm})
	var heal := int(ceil(float(u.get("heal", 0.0)) * float(h.max_hp())))
	var mp := int(ceil(float(u.get("mp", 0.0)) * float(h.max_mp())))
	var gain_hp := mini(heal, h.max_hp() - h.hp) if heal > 0 else 0
	var gain_mp := mini(mp, h.max_mp() - h.mp) if mp > 0 else 0
	if gain_hp <= 0 and gain_mp <= 0:
		return text("no_need", {"name": h.name, "item": nm})
	h.hp += gain_hp
	h.mp += gain_mp
	h.inventory.erase(id)
	return text("used", {"name": h.name, "item": nm})


## Whether a pack item has a use here (for the Use button).
static func usable(id: String) -> bool:
	return not (GameItems.item_def(id).get("use", {}) as Dictionary).is_empty()


# ---------------------------------------------------------------- services

static func service_price(d: GameDynasty, s: Dictionary) -> int:
	return maxi(1, int(round(float(s["price"]) * GameItems.price_mult(d))))


static func serve(d: GameDynasty, shop_id: String, service_id: String) -> String:
	var h := d.heir
	if not d.world.has_service(shop_id):
		return text("not_here", {"shop": name_of(shop_id)})
	for s in def(shop_id).get("services", []):
		if str(s["id"]) != service_id:
			continue
		var cost := service_price(d, s)
		if h.gold < cost:
			return text("no_gold", {"name": h.name, "item": str(s["name"]).to_lower(), "price": GameText.num(cost)})
		if d.battle != null:
			return text("no_use", {"item": str(s["name"])})
		var gain_hp := int(ceil(float(s.get("heal", 0.0)) * float(h.max_hp())))
		var gain_mp := int(ceil(float(s.get("mp", 0.0)) * float(h.max_mp())))
		if mini(gain_hp, h.max_hp() - h.hp) <= 0 and mini(gain_mp, h.max_mp() - h.mp) <= 0:
			return text("no_need", {"name": h.name, "item": str(s["name"]).to_lower()})
		h.gold -= cost
		h.hp = mini(h.max_hp(), h.hp + gain_hp)
		h.mp = mini(h.max_mp(), h.mp + gain_mp)
		return text("service_done", {"name": h.name, "price": GameText.num(cost), "shop": name_of(shop_id), "what": str(s["desc"]).trim_suffix(".").to_lower()})
	return text("no_service", {"shop": name_of(shop_id)})


# ---------------------------------------------------------------- the data

static func validate() -> Array:
	var bad: Array = []
	var dat := data()
	for k in ["settings", "text", "shops"]:
		if not dat.has(k):
			return ["shops.json: %s is missing" % k]
	GameData.load_all()
	var tabs := {}
	var old := ["forge", "temple", "store", "tavern", "board", "black_market"]
	var listed := {}
	for s in dat["shops"]:
		var id := str(s.get("id", ""))
		for k in ["id", "name", "tab", "note", "job", "towns", "hours", "markup", "buy", "tier_bonus", "buys", "stock", "services"]:
			if not s.has(k):
				bad.append("shops.json: '%s' has no %s" % [id, k])
		if not bad.is_empty():
			return bad
		if listed.has(id) or id in old:
			bad.append("shops.json: '%s' is listed twice or is an old service" % id)
		listed[id] = true
		if str(s["tab"]) in tabs or str(s["tab"]).length() > 12 or str(s["tab"]) == "":
			bad.append("shops.json: the tab of '%s' is repeated, empty or longer than 12 characters" % id)
		tabs[str(s["tab"])] = true
		var hrs: Array = s["hours"]
		if hrs.size() != 2 or float(hrs[0]) < 0.0 or float(hrs[1]) > 24.0 or float(hrs[0]) >= float(hrs[1]):
			bad.append("shops.json: '%s' hours are [open, close] within 0 to 24" % id)
		if float(s["markup"]) <= 0.0 or float(s["buy"]) <= 0.0 or float(s["buy"]) >= 1.0:
			bad.append("shops.json: '%s' needs a markup above 0 and a buy share between 0 and 1" % id)
		if (s["towns"] as Array).is_empty():
			bad.append("shops.json: '%s' is in no town" % id)
		for t in s["towns"]:
			if id not in GameWorld.place(str(t)).get("services", []):
				bad.append("shops.json: '%s' is said to be in %s, which does not list it in world.json" % [id, t])
		if not GameSpaces.data()["rooms"].has(id) or not GameSpaces.data()["service_names"].has(id):
			bad.append("shops.json: '%s' has no rooms or name in spaces.json" % id)
		if not GameTown.data()["sizes"].has(id):
			bad.append("shops.json: '%s' has no size in towns.json" % id)
		if not BuildingArt.data()["kinds"].has(id):
			bad.append("shops.json: '%s' has no look in buildings.json" % id)
		if not GameVillagers.data()["service"].has(id) or not GameVillagers.data()["service_jobs"].has(id):
			bad.append("shops.json: '%s' has no keeper in villagers.json" % id)
		var keepers := GamePeople.in_space("world/%s/%s" % [str(s["towns"][0]), id])
		if keepers.size() != 1:
			bad.append("shops.json: '%s' needs one person in people.json" % id)
		var pools: Array = s["stock"]
		if pools.is_empty():
			bad.append("shops.json: '%s' has no stock" % id)
		for p in pools:
			bad.append_array(_pool_problems(id, p))
		for sv in s["services"]:
			for k in ["id", "name", "desc", "price"]:
				if not sv.has(k):
					bad.append("shops.json: a service of '%s' has no %s" % [id, k])
	for l in GameData.world["locations"]:
		for sv in l.get("services", []):
			if str(sv) not in old and not listed.has(str(sv)):
				bad.append("world.json: %s lists the service '%s', which is neither old nor in shops.json" % [l["id"], sv])
	for id in GameData.items:
		var it: Dictionary = GameData.items[id]
		if it.has("use"):
			for k in it["use"]:
				if str(k) not in ["heal", "mp"] or float(it["use"][k]) <= 0.0 or float(it["use"][k]) > 1.0:
					bad.append("items.json: '%s' has a use '%s' that is not heal or mp between 0 and 1" % [id, k])
		for sn in it.get("seasons", []):
			if str(sn) not in ["spring", "summer", "autumn", "winter"]:
				bad.append("items.json: '%s' has the unknown season '%s'" % [id, sn])
	return bad


static func _pool_problems(id: String, p: Dictionary) -> Array:
	var bad: Array = []
	var tag := "shops.json: a pool of '%s'" % id
	var t := str(p.get("type", ""))
	if t not in ["items", "loot", "materials", "animals"]:
		return [tag + " has the unknown type '%s'" % t]
	var c: Array = p.get("count", [])
	if c.size() != 2 or int(c[0]) < 0 or int(c[1]) < int(c[0]):
		bad.append(tag + " needs a count [min, max]")
	match t:
		"items":
			for k in ["kinds", "tags", "ids"]:
				if not p.has(k):
					bad.append(tag + " has no " + k)
			for i in p.get("ids", []):
				if not GameData.items.has(str(i)):
					bad.append(tag + " names the unknown item '%s'" % i)
			if p.get("ids", []).is_empty() and p.get("kinds", []).is_empty() and p.get("tags", []).is_empty():
				bad.append(tag + " names nothing")
			elif p.get("ids", []).is_empty() or not p.get("kinds", []).is_empty() or not p.get("tags", []).is_empty():
				var any := false
				for iid in GameData.items:
					if GameShopStock.item_fits(p, str(iid), 9, "") or GameShopStock.item_fits(p, str(iid), 9, "spring"):
						any = true
						break
				if not any:
					bad.append(tag + " matches no item")
		"loot":
			var forms: Array = []
			for f in GameLoot.data()["forms"]:
				if str(f["slot"]) == str(p.get("slot", "")):
					forms.append(str(f["id"]))
			if forms.is_empty():
				bad.append(tag + " has the unknown slot '%s'" % p.get("slot", ""))
			for f in p.get("forms", []):
				if str(f) not in forms:
					bad.append(tag + " has the form '%s', which is not a form of that slot" % f)
			for k in ["rarity_min", "rarity_max"]:
				if str(p.get(k, "")) not in GameShopStock.RARITY_ORDER.slice(0, 5):
					bad.append(tag + " has the unknown or unsellable %s" % k)
		"materials":
			for m in p.get("ids", []):
				if not GameMaterials.has(str(m)):
					bad.append(tag + " names the unknown material '%s'" % m)
			if int(p.get("bundle", 0)) < 1:
				bad.append(tag + " needs a bundle of at least 1")
		"animals":
			for sp in p.get("species", []):
				if GameFarm.price(str(sp)) <= 0:
					bad.append(tag + " names '%s', which the farm market does not sell" % sp)
	return bad
