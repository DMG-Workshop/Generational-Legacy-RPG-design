	GameMessages.problems.clear()


# ---------------------------------------------------------------- the validator

func test_validator() -> void:
	var found := Check.problems()
	ok(found.is_empty(), "the data check finds nothing" + ("" if found.is_empty() else ": " + str(found.slice(0, 5))))
	var saved: Dictionary = GameData.life.duplicate(true)
	# a line the code asks for goes missing
	GameData.life["lines"].erase("rests")
	ok(Check.problems().any(func(p): return "'rests'" in p and "life catalog does not have" in p), "a missing life line is found")
	GameData.life = saved.duplicate(true)
	# a line nothing asks for
	GameData.life["lines"]["orphan_line"] = "Nobody says this."
	ok(Check.problems().any(func(p): return "'orphan_line'" in p and "nothing asks for it" in p), "an orphan life line is found")
	GameData.life = saved.duplicate(true)
	GameData.life["lines"]["rests"] = "  "
	ok(Check.problems().any(func(p): return "'rests'" in p and "not text" in p), "an empty life line is found")
	GameData.life = saved


# ---------------------------------------------------------------- the locale

func test_locale() -> void:
	var src := str(GameLocale.source_lines("life")["rests"])
	ok(GameLocale.text("life", "rests", src) == src, "with no translation the source line is read")
	GameLocale.current = "pseudo"
	var p := GameMessages.text("life", "rests", {"name": "Tess"})
	ok(p.begins_with("[") and p.ends_with("]") and "Tess" in p, "the pseudo-language brackets the line and keeps the name: %s" % p)
	GameLocale.current = ""
	ok(GameMessages.text("life", "rests", {"name": "Tess"}) == "Tess rests and recovers fully.", "back in English nothing of it remains")
	ok(GameLocale.source_lines("life").size() >= 40, "the life catalog is read as a catalog (%d lines)" % GameLocale.source_lines("life").size())
