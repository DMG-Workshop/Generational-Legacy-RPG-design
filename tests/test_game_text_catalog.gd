## Item 28 (the rest of the game's text in data): every line moved out of core/game into data/text/life.json renders
## exactly as the old code printed it. Each case keeps the old GDScript expression (the format string and its values as the
## code wrote them) and checks the catalog line with the same values. The validator refuses an orphan key and a missing one,
## and the locale still reads the source text when no translation exists.
## Run: godot --headless --path . -s res://tests/test_game_text_catalog.gd
extends SceneTree

const Check := preload("res://tools/check_data.gd")

var fails := 0
var checks := 0


func ok(cond: bool, what: String) -> void:
	checks += 1
	if not cond:
		fails += 1
		print("FAIL: ", what)


func _init() -> void:
	_run.call_deferred()


func _run() -> void:
	GameData.load_all()
	test_moved_lines()
	test_validator()
	test_locale()
	print("text catalog tests: %d checks, %d failures" % [checks, fails])
	quit(1 if fails > 0 else 0)


